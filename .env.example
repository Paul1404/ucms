# PostgreSQL connection string.
# On Railway this is auto-provided when you attach a Postgres service.
# Use a reference variable in the Railway dashboard: ${{Postgres.DATABASE_URL}}
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/ucms"

# Secret used to sign sessions and cookies. Generate a long random value.
# openssl rand -base64 32
BETTER_AUTH_SECRET="change-me-to-a-long-random-string"

# Public URL of the deployed app. Used by better-auth for cookies and callbacks.
# Local: http://localhost:3000
BETTER_AUTH_URL="http://localhost:3000"

# Port the server listens on. Railway injects this automatically.
PORT="3000"
