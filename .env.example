# PostgreSQL connection string.
# On Railway this is auto-provided when you attach a Postgres service.
# Use a reference variable in the Railway dashboard: ${{Postgres.DATABASE_URL}}
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/ucms"

# Secret used to sign sessions and cookies. Generate a long random value.
# openssl rand -base64 32
BETTER_AUTH_SECRET="change-me-to-a-long-random-string"

# Public URL of the deployed app. Used by better-auth for cookies and callbacks.
# Local: http://localhost:3000
BETTER_AUTH_URL="http://localhost:3000"

# Port the server listens on. Railway injects this automatically.
PORT="3000"

# S3-compatible object storage for uploads (optional). When these are set,
# uploads go to the bucket; otherwise they are stored in the database.
# On Railway these are injected when a Bucket service is connected
# (style: "AWS SDK Generic"). Use reference variables, e.g. ${{Bucket.BUCKET_NAME}}.
AWS_REGION=""
AWS_ENDPOINT_URL_S3=""
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
BUCKET_NAME=""
